# 构建产物(idf.py build 生成, 可随时重建)
build/
# Windows 时代构建缓存的留档(2026-08-24 迁移 Linux 时改名, CMake 缓存跨平台不可复用)
build.win64.bak/

# 由 sdkconfig.defaults 生成的本地配置(含本机路径差异)
sdkconfig
sdkconfig.old

# idf.py 依据 main/idf_component.yml 自动拉取的组件
# 版本由 dependencies.lock 锁定, 提交 lock 即可还原
managed_components/

# IDE / 工具缓存
.vscode/
.idea/
.cache/
.clang-format
*.swp

# WiFi 凭据(本地私有, 模板见 wifi_secrets.h.example; CMake 缺文件会直接报错)
main/wifi_secrets.h

# 智谱 GLM API Key(本地私有, 模板见 glm_secrets.h.example; CMake 缺文件会直接报错)
main/glm_secrets.h

# BLE 密钥账户表(本地私有, 模板见 keys_secrets.h.example; CMake 缺文件会直接报错)
main/keys_secrets.h
