// main/keys_secrets.h.example -- BLE 密钥账户模板(被 git 追踪)。
// 使用: 复制本文件为同目录 keys_secrets.h 并填入真实账户;
// keys_secrets.h 已被 .gitignore 排除, 不会进入提交历史。
// 密码只经 BLE 加密链路键入到已配对终端, 本机屏幕永不显示。
#pragma once

#include <stdbool.h>

// KEYS 页列表按 KKEY_COUNT 逐项显示; name 超宽时选中项循环滚动。
// pass 只支持 ASCII 可见字符(0x20-0x7E), 按 US 键盘布局键入,
// 目标终端若非 US 布局, 字母数字不受影响, 特殊符号可能错位。
typedef struct {
    const char *name;     // 账户名(列表主行)
    const char *acct_id;  // 账户 ID/邮箱(列表辅助行, 只显示不键入)
    const char *pass;     // 密码(BLE 键入输出)
    bool enter;           // 键入完密码后自动补回车(直接提交登录框)
} kkey_acc_t;

#define KKEY_ACCS { \
    { "Example", "user@example.com", "YOUR_PASSWORD", true }, \
}
